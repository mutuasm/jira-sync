 "field_order": [
  "enabled",
  "jira_section",
  "jira_url",
  "jira_user_email",
  "api_token",
  "jira_account_id",
  "webhook_section",
  "webhook_secret",
  "sync_section",
  "sync_projects",
  "sync_tasks",
  "sync_timesheets",
